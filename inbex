<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>コマ移動盤</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#f0f0f0;
    font-family:sans-serif;
}

#board{
    width:min(96vw,96vh);
    height:min(96vw,96vh);

    display:grid;
    grid-template-columns:repeat(8,1fr);
    grid-template-rows:repeat(8,1fr);

    gap:2px;
    background:#333;
    padding:2px;
}

.cell{
    background:white;
    position:relative;
}

.piece{
    width:80%;
    height:80%;
    border-radius:50%;
    position:absolute;
    left:10%;
    top:10%;
}

.red{
    background:#e53935;
}

.blue{
    background:#1e88e5;
}

.selected{
    outline:6px solid gold;
    outline-offset:2px;
}
</style>
</head>
<body>

<div id="board"></div>

<script>

const startBoard = [
["B","","R","","","B","","R"],
["","","","","","","",""],
["R","","","","","","","B"],
["","","","","","","",""],
["","","","","","","",""],
["B","","","","","","","R"],
["","","","","","","",""],
["R","","B","","","R","","B"]
];

const board = document.getElementById("board");

let selectedPiece = null;

function createPiece(color){

    const piece = document.createElement("div");
    piece.className = "piece " + color;

    piece.addEventListener("click",(e)=>{

        e.stopPropagation();

        document
            .querySelectorAll(".piece")
            .forEach(p=>p.classList.remove("selected"));

        selectedPiece = piece;
        piece.classList.add("selected");
    });

    return piece;
}

for(let y=0;y<8;y++){

    for(let x=0;x<8;x++){

        const cell = document.createElement("div");
        cell.className = "cell";

        if(startBoard[y][x] === "R"){
            cell.appendChild(createPiece("red"));
        }

        if(startBoard[y][x] === "B"){
            cell.appendChild(createPiece("blue"));
        }

        cell.addEventListener("click",()=>{

            if(!selectedPiece) return;

            const existing = cell.querySelector(".piece");

            if(existing){
                existing.remove();
            }

            cell.appendChild(selectedPiece);

            selectedPiece.classList.remove("selected");
            selectedPiece = null;
        });

        board.appendChild(cell);
    }
}

</script>

</body>
</html>